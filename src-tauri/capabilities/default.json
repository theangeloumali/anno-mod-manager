{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window may call only the app's own commands, the open-file dialog and mod.io links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://mod.io/*" }, { "url": "https://*.mod.io/*" }]
    }
  ]
}
